# =============================================
# APPLICATION: ${entityName}
# Generated by Spring Boot Scaffold Generator
# =============================================
spring.application.name=${entityNameLower}
server.port=${assignedPort}

# =============================================
# DATABASE
# =============================================
<#if database == "h2">
spring.datasource.url=jdbc:h2:mem:${entityNameLower}db;DB_CLOSE_DELAY=-1
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console
spring.h2.console.settings.web-allow-others=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.H2Dialect
# MySQL (production) — uncomment to use:
# spring.datasource.url=jdbc:mysql://scaffold-mysql:3306/${entityNameLower}db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# spring.datasource.username=said
# Password hidden: this value is not stored in the repository. Set the environment variable SPRING_DATASOURCE_PASSWORD before running the app.
# spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
# spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
<#elseif database == "mysql">
# H2 (disabled) — uncomment to switch to in-memory:
# spring.datasource.url=jdbc:h2:mem:${entityNameLower}db;DB_CLOSE_DELAY=-1
# spring.datasource.driver-class-name=org.h2.Driver
# spring.datasource.username=sa
# spring.datasource.password=
# spring.h2.console.enabled=true
# spring.h2.console.path=/h2-console
# spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.H2Dialect
spring.datasource.url=jdbc:mysql://scaffold-mysql:3306/${entityNameLower}db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# Password hidden: this value is not stored in the repository. Set the environment variable SPRING_DATASOURCE_PASSWORD before running the app.
spring.datasource.username=said
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
<#elseif database == "postgresql">
spring.datasource.url=jdbc:postgresql://scaffold-postgres:5432/${entityNameLower}db
spring.datasource.driver-class-name=org.postgresql.Driver
# Password hidden: this value is not stored in the repository. Set the environment variable SPRING_DATASOURCE_PASSWORD before running the app.
spring.datasource.username=said
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
<#elseif database == "mongodb">
spring.data.mongodb.uri=mongodb://localhost:27017/${entityNameLower}db
</#if>

<#if database != "mongodb">
# =============================================
# JPA / HIBERNATE
# =============================================
<#if database == "mysql">
spring.jpa.hibernate.ddl-auto=update
<#else>
spring.jpa.hibernate.ddl-auto=create-drop
</#if>
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
<#if database == "mysql">
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
</#if>
</#if>

<#if kafkaProducer?? && (kafkaProducer || kafkaConsumer)>
# =============================================
# KAFKA
# =============================================
# Docker (via docker-compose): scaffold-kafka:9092
# Local (mvn spring-boot:run): localhost:29092
spring.kafka.bootstrap-servers=localhost:29092
# spring.kafka.bootstrap-servers=scaffold-kafka:9092
spring.kafka.consumer.group-id=${entityNameLower}-group
spring.kafka.consumer.auto-offset-reset=earliest
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.apache.kafka.common.serialization.StringSerializer
# Prevent app crash if Kafka is unavailable on startup
spring.kafka.listener.missing-topics-fatal=false

</#if>

<#if includeSwagger>
# =============================================
# SPRINGDOC / SWAGGER UI
# =============================================
springdoc.api-docs.enabled=true
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.try-it-out-enabled=true
springdoc.packages-to-scan=${basePackage}.${entityNameLower}.controller
</#if>
# =============================================
# LOGGING
# =============================================
logging.level.${basePackage}=DEBUG
logging.level.org.springframework.web=INFO
